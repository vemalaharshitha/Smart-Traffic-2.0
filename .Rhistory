"    # ==============================",
"",
"    if total >= 15:",
"        traffic_level = 'HIGH'",
"    elif total >= 7:",
"        traffic_level = 'MEDIUM'",
"    else:",
"        traffic_level = 'LOW'",
"",
"    # ==============================",
"    # TRAFFIC RISK SCORE",
"    # ==============================",
"",
"    risk_score = min(total / 20.0, 1.0)",
"",
"    if risk_score >= 0.75:",
"        risk_status = 'HIGH RISK'",
"    elif risk_score >= 0.40:",
"        risk_status = 'MEDIUM RISK'",
"    else:",
"        risk_status = 'LOW RISK'",
"",
"    # ==============================",
"    # TIME",
"    # ==============================",
"",
"    video_time = frame_number / fps_video if fps_video > 0 else 0",
"",
"    # ==============================",
"    # INFORMATION PANEL",
"    # ==============================",
"",
"    cv2.rectangle(",
"        annotated,",
"        (20, 20),",
"        (610, 205),",
"        (0, 0, 0),",
"        -1",
"    )",
"",
"    cv2.putText(",
"        annotated,",
"        'SMART TRAFFIC 2.0',",
"        (40, 55),",
"        cv2.FONT_HERSHEY_SIMPLEX,",
"        0.85,",
"        (255, 255, 255),",
"        2",
"    )",
"",
"    cv2.putText(",
"        annotated,",
"        f'Vehicles: {total}',",
"        (40, 85),",
"        cv2.FONT_HERSHEY_SIMPLEX,",
"        0.60,",
"        (255, 255, 255),",
"        2",
"    )",
"",
"    cv2.putText(",
"        annotated,",
"        f'Cars: {counts[\"car\"]}  Bikes: {counts[\"motorcycle\"]}',",
"        (40, 113),",
"        cv2.FONT_HERSHEY_SIMPLEX,",
"        0.55,",
"        (255, 255, 255),",
"        2",
"    )",
"",
"    cv2.putText(",
"        annotated,",
"        f'Buses: {counts[\"bus\"]}  Trucks: {counts[\"truck\"]}',",
"        (40, 140),",
"        cv2.FONT_HERSHEY_SIMPLEX,",
"        0.55,",
"        (255, 255, 255),",
"        2",
"    )",
"",
"    cv2.putText(",
"        annotated,",
"        f'Traffic: {traffic_level}',",
"        (40, 168),",
"        cv2.FONT_HERSHEY_SIMPLEX,",
"        0.55,",
"        (255, 255, 255),",
"        2",
"    )",
"",
"    cv2.putText(",
"        annotated,",
"        f'Risk: {risk_score:.2f} - {risk_status}',",
"        (40, 195),",
"        cv2.FONT_HERSHEY_SIMPLEX,",
"        0.55,",
"        (255, 255, 255),",
"        2",
"    )",
"",
"    # ==============================",
"    # SAVE CSV RESULT",
"    # ==============================",
"",
"    csv_writer.writerow([",
"        frame_number,",
"        round(video_time, 3),",
"        counts['car'],",
"        counts['motorcycle'],",
"        counts['bus'],",
"        counts['truck'],",
"        total,",
"        traffic_level,",
"        round(risk_score, 3)",
"    ])",
"",
"    # ==============================",
"    # WRITE OUTPUT VIDEO",
"    # ==============================",
"",
"    writer.write(annotated)",
"",
"    # ==============================",
"    # DISPLAY",
"    # ==============================",
"",
"    cv2.imshow(",
"        'Smart Traffic 2.0 - Live Traffic Analysis',",
"        annotated",
"    )",
"",
"    # Progress",
"    if frame_number % 30 == 0:",
"        elapsed = time.time() - start_time",
"        processing_fps = frame_number / elapsed if elapsed > 0 else 0",
"        progress = (frame_number / total_frames) * 100",
"",
"        print(",
"            f'Progress: {progress:5.1f}% | '",
"            f'Frame: {frame_number}/{total_frames} | '",
"            f'Vehicles: {total} | '",
"            f'Processing FPS: {processing_fps:.1f}'",
"        )",
"",
"    # Press Q to stop",
"    if cv2.waitKey(1) & 0xFF == ord('q'):",
"        break",
"",
"# ==============================",
"# CLEANUP",
"# ==============================",
"",
"cap.release()",
"writer.release()",
"csv_file.close()",
"cv2.destroyAllWindows()",
"",
"print('')",
"print('=========================================')",
"print('SMART TRAFFIC 2.0 COMPLETE')",
"print('=========================================')",
"print(f'Annotated video: {OUTPUT_VIDEO}')",
"print(f'Analysis CSV:    {OUTPUT_CSV}')",
"print('=========================================')"
), smart_traffic_script)
file.exists(smart_traffic_script)
smart_traffic_script <- file.path(getwd(), "R", "smart_traffic.py")
writeLines(c(
"from ultralytics import YOLO",
"import cv2",
"import os",
"import csv",
"import time",
"import torch",
"",
"# ==============================",
"# SMART TRAFFIC 2.0 CONFIGURATION",
"# ==============================",
"",
"VIDEO = os.path.join('data', 'Traffic_Video.mp4')",
"OUTPUT_VIDEO = os.path.join('outputs', 'smart_traffic_output.mp4')",
"OUTPUT_CSV = os.path.join('outputs', 'traffic_results.csv')",
"",
"os.makedirs('outputs', exist_ok=True)",
"",
"# YOLO vehicle classes from COCO",
"VEHICLE_CLASSES = {",
"    2: 'car',",
"    3: 'motorcycle',",
"    5: 'bus',",
"    7: 'truck'",
"}",
"",
"CONFIDENCE = 0.20",
"IMAGE_SIZE = 640",
"",
"# ==============================",
"# SELECT DEVICE",
"# ==============================",
"",
"if torch.cuda.is_available():",
"    DEVICE = 0",
"    print('GPU detected - using CUDA')",
"else:",
"    DEVICE = 'cpu'",
"    print('GPU not detected - using CPU')",
"",
"# ==============================",
"# LOAD MODEL",
"# ==============================",
"",
"print('Loading YOLO11n...')",
"model = YOLO('yolo11n.pt')",
"print('YOLO11n loaded successfully.')",
"",
"# ==============================",
"# OPEN VIDEO",
"# ==============================",
"",
"cap = cv2.VideoCapture(VIDEO)",
"",
"if not cap.isOpened():",
"    raise RuntimeError(f'Could not open video: {VIDEO}')",
"",
"fps_video = cap.get(cv2.CAP_PROP_FPS)",
"total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))",
"width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))",
"height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))",
"",
"duration = total_frames / fps_video if fps_video > 0 else 0",
"",
"print('')",
"print('=========================================')",
"print('SMART TRAFFIC 2.0')",
"print('=========================================')",
"print(f'Video: {VIDEO}')",
"print(f'Resolution: {width} x {height}')",
"print(f'FPS: {fps_video:.2f}')",
"print(f'Frames: {total_frames}')",
"print(f'Duration: {duration:.2f} seconds')",
"print('=========================================')",
"",
"# ==============================",
"# VIDEO WRITER",
"# ==============================",
"",
"fourcc = cv2.VideoWriter_fourcc(*'mp4v')",
"writer = cv2.VideoWriter(",
"    OUTPUT_VIDEO,",
"    fourcc,",
"    fps_video,",
"    (width, height)",
")",
"",
"# ==============================",
"# CSV OUTPUT",
"# ==============================",
"",
"csv_file = open(OUTPUT_CSV, 'w', newline='', encoding='utf-8')",
"csv_writer = csv.writer(csv_file)",
"",
"csv_writer.writerow([",
"    'frame',",
"    'time_seconds',",
"    'cars',",
"    'motorcycles',",
"    'buses',",
"    'trucks',",
"    'total_vehicles',",
"    'traffic_level',",
"    'risk_score'",
"])",
"",
"# ==============================",
"# PROCESS VIDEO",
"# ==============================",
"",
"frame_number = 0",
"start_time = time.time()",
"",
"while True:",
"    ret, frame = cap.read()",
"",
"    if not ret:",
"        break",
"",
"    frame_number += 1",
"",
"    # YOLO detection + tracking",
"    results = model.track(",
"        frame,",
"        persist=True,",
"        tracker='bytetrack.yaml',",
"        conf=CONFIDENCE,",
"        imgsz=IMAGE_SIZE,",
"        classes=list(VEHICLE_CLASSES.keys()),",
"        device=DEVICE,",
"        verbose=False",
"    )",
"",
"    result = results[0]",
"",
"    # Smaller and cleaner visual annotations",
"    annotated = result.plot(",
"        labels=True,",
"        conf=True,",
"        line_width=2,",
"        font_size=12",
"    )",
"",
"    # ==============================",
"    # COUNT VEHICLES",
"    # ==============================",
"",
"    counts = {",
"        'car': 0,",
"        'motorcycle': 0,",
"        'bus': 0,",
"        'truck': 0",
"    }",
"",
"    tracked_ids = set()",
"",
"    if result.boxes is not None:",
"        for box in result.boxes:",
"            class_id = int(box.cls[0])",
"",
"            if class_id not in VEHICLE_CLASSES:",
"                continue",
"",
"            vehicle_name = VEHICLE_CLASSES[class_id]",
"            counts[vehicle_name] += 1",
"",
"            if box.id is not None:",
"                tracked_ids.add(int(box.id[0]))",
"",
"    total = len(tracked_ids)",
"",
"    # ==============================",
"    # TRAFFIC LEVEL",
"    # ==============================",
"",
"    if total >= 15:",
"        traffic_level = 'HIGH'",
"    elif total >= 7:",
"        traffic_level = 'MEDIUM'",
"    else:",
"        traffic_level = 'LOW'",
"",
"    # ==============================",
"    # TRAFFIC RISK SCORE",
"    # ==============================",
"",
"    risk_score = min(total / 20.0, 1.0)",
"",
"    if risk_score >= 0.75:",
"        risk_status = 'HIGH RISK'",
"    elif risk_score >= 0.40:",
"        risk_status = 'MEDIUM RISK'",
"    else:",
"        risk_status = 'LOW RISK'",
"",
"    # ==============================",
"    # TIME",
"    # ==============================",
"",
"    video_time = frame_number / fps_video if fps_video > 0 else 0",
"",
"    # ==============================",
"    # INFORMATION PANEL",
"    # ==============================",
"",
"    cv2.rectangle(",
"        annotated,",
"        (20, 20),",
"        (610, 205),",
"        (0, 0, 0),",
"        -1",
"    )",
"",
"    cv2.putText(",
"        annotated,",
"        'SMART TRAFFIC 2.0',",
"        (40, 55),",
"        cv2.FONT_HERSHEY_SIMPLEX,",
"        0.85,",
"        (255, 255, 255),",
"        2",
"    )",
"",
"    cv2.putText(",
"        annotated,",
"        f'Vehicles: {total}',",
"        (40, 85),",
"        cv2.FONT_HERSHEY_SIMPLEX,",
"        0.60,",
"        (255, 255, 255),",
"        2",
"    )",
"",
"    cv2.putText(",
"        annotated,",
"        f'Cars: {counts[\"car\"]}  Bikes: {counts[\"motorcycle\"]}',",
"        (40, 113),",
"        cv2.FONT_HERSHEY_SIMPLEX,",
"        0.55,",
"        (255, 255, 255),",
"        2",
"    )",
"",
"    cv2.putText(",
"        annotated,",
"        f'Buses: {counts[\"bus\"]}  Trucks: {counts[\"truck\"]}',",
"        (40, 140),",
"        cv2.FONT_HERSHEY_SIMPLEX,",
"        0.55,",
"        (255, 255, 255),",
"        2",
"    )",
"",
"    cv2.putText(",
"        annotated,",
"        f'Traffic: {traffic_level}',",
"        (40, 168),",
"        cv2.FONT_HERSHEY_SIMPLEX,",
"        0.55,",
"        (255, 255, 255),",
"        2",
"    )",
"",
"    cv2.putText(",
"        annotated,",
"        f'Risk: {risk_score:.2f} - {risk_status}',",
"        (40, 195),",
"        cv2.FONT_HERSHEY_SIMPLEX,",
"        0.55,",
"        (255, 255, 255),",
"        2",
"    )",
"",
"    # ==============================",
"    # SAVE CSV RESULT",
"    # ==============================",
"",
"    csv_writer.writerow([",
"        frame_number,",
"        round(video_time, 3),",
"        counts['car'],",
"        counts['motorcycle'],",
"        counts['bus'],",
"        counts['truck'],",
"        total,",
"        traffic_level,",
"        round(risk_score, 3)",
"    ])",
"",
"    # ==============================",
"    # WRITE OUTPUT VIDEO",
"    # ==============================",
"",
"    writer.write(annotated)",
"",
"    # ==============================",
"    # DISPLAY",
"    # ==============================",
"",
"    cv2.imshow(",
"        'Smart Traffic 2.0 - Live Traffic Analysis',",
"        annotated",
"    )",
"",
"    # Progress",
"    if frame_number % 30 == 0:",
"        elapsed = time.time() - start_time",
"        processing_fps = frame_number / elapsed if elapsed > 0 else 0",
"        progress = (frame_number / total_frames) * 100",
"",
"        print(",
"            f'Progress: {progress:5.1f}% | '",
"            f'Frame: {frame_number}/{total_frames} | '",
"            f'Vehicles: {total} | '",
"            f'Processing FPS: {processing_fps:.1f}'",
"        )",
"",
"    # Press Q to stop",
"    if cv2.waitKey(1) & 0xFF == ord('q'):",
"        break",
"",
"# ==============================",
"# CLEANUP",
"# ==============================",
"",
"cap.release()",
"writer.release()",
"csv_file.close()",
"cv2.destroyAllWindows()",
"",
"print('')",
"print('=========================================')",
"print('SMART TRAFFIC 2.0 COMPLETE')",
"print('=========================================')",
"print(f'Annotated video: {OUTPUT_VIDEO}')",
"print(f'Analysis CSV:    {OUTPUT_CSV}')",
"print('=========================================')"
), smart_traffic_script)
system2(
"py",
args = c("-3.13", shQuote("R/smart_traffic.py"))
)
file.exists(smart_traffic_script)
file.exists("outputs/smart_traffic_output.mp4")
file.exists("outputs/traffic_results.csv")
